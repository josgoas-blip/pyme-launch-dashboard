# Plantilla de variables de entorno — Pyme Launch Dashboard
# CLAUDE.md (regla 3): NO hardcodear claves/tokens. Copiar a .env y rellenar valores reales.
# El prefijo VITE_ es obligatorio para exponer variables al frontend (Vite).

# --- Supabase (Backend / BD: PostgreSQL + RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- n8n (Orquestador: Webhooks + OpenAI LLM) ---
# Webhook del Agente IA consultor flotante.
# Recibe { mensaje, clienteId, respuestasDiagnostico } y debe devolver { respuesta: "..." }.
# Si se deja vacío, el chat degrada a explicaciones locales simuladas.
# Ejemplo: https://<tu-instancia>.app.n8n.cloud/webhook/agente-consultor
VITE_N8N_WEBHOOK_URL=

# Webhook de agendado de la Sesión Estratégica de Mentoría.
# Recibe { id_usuario, expediente_id, cliente_nombre, cliente_email,
#          fecha_propuesta, fase, score_total } y registra la solicitud.
# Si se deja vacío se usa la instancia por defecto del proyecto.
# Ejemplo: https://<tu-instancia>.app.n8n.cloud/webhook/webhook-agendar-consultoria
VITE_N8N_WEBHOOK_CITA_URL=
# Webhook de cancelación de la Sesión Estratégica.
# Recibe { tipo: "cancelacion_sesion", id_usuario, expediente_id, cliente_nombre,
#          cliente_email, fila_cita_id, fecha_sesion_cancelada, meet_url, motivo,
#          cancelada_en, actualizada_en_supabase } para avisar al mentor, anular
# el evento del calendario y, si actualizada_en_supabase es false, marcar
# la fila como cancelada con permisos de servicio.
# Sin valor por defecto: si se deja vacío, el mentor no recibe aviso automático.
VITE_N8N_WEBHOOK_CANCELACION_URL=

# --- Supabase Auth: recuperación de contraseña ---
# Dirección a la que vuelve el usuario desde el correo de recuperación.
# Debe figurar en Supabase → Authentication → URL Configuration → Redirect URLs.
# Si se deja vacío se usa https://demo.pymelaunch.com/reset-password
VITE_URL_RESET_PASSWORD=

# --- Modo demo ---
# Muestra el selector de plan de la barra superior y los botones "Mejorar a…",
# que simulan planes en local para probar los bloqueos (nunca escriben en
# profiles.plan_contratado). Activo por defecto; en producción, poner a false
# para que el plan dependa solo de la base de datos.
VITE_MODO_DEMO=
